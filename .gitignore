# Build output. Generated test reports and metrics live in target/test-results/.
/target

# Local developer scratch: certificates, keys and anything else that is only
# meaningful on one machine. Everything local goes here, so no new rule is needed
# the next time something has to be kept out of the repository.
/.local/

# Runtime state of a locally started CLI or server.
/db_storage/
.edit_*.tmp*

# Tooling.
/.junie/
/.idea/
/.env
__pycache__/
*.pyc

# Front-end dependencies. The built bundle in
# crates/core/src/web/assets/dist is deliberately committed so `cargo build`
# needs no node toolchain.
node_modules/
