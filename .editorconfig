# Editor settings for the whole repository.
#
# JetBrains IDEs (RustRover, WebStorm) honour this file automatically, as do
# VS Code with the EditorConfig extension, and most other editors. It settles
# the things that otherwise change from machine to machine and show up as noise
# in a diff: indentation, line endings, trailing whitespace.
#
# The dashboard front end additionally has Prettier (crates/core/src/web/ui),
# which owns everything below indentation - quotes, semicolons, line breaks.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 110

# Recipes are passed to the shell verbatim: a leading space instead of a tab is
# a syntax error, not a style choice.
[{Makefile,*.mk}]
indent_style = tab

[*.{toml,yml,yaml,json}]
indent_size = 2

# Vue single-file components and their templates read better at two, which is
# also what the IDE and Prettier both produce for them.
[*.{vue,html,css}]
indent_size = 2

[*.{ts,js,mts,cts}]
indent_size = 4
max_line_length = 100

# Two trailing spaces are a line break in Markdown, so they are not whitespace
# to be tidied away.
[*.md]
trim_trailing_whitespace = false

# Generated by Vite; nothing here is hand-edited.
[crates/core/src/web/assets/dist/**]
trim_trailing_whitespace = false
insert_final_newline = false
